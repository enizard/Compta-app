<%- include('partials/header') %>
<h1>Administration</h1>

<h2 id="societes">Sociétés</h2>
<p class="muted">Exercice comptable et modèle des factures de ventes de chaque société. La numérotation des factures est propre à chaque société.</p>
<% const MOIS = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre']; %>
<% societes.forEach(e => { %>
<details class="card">
  <summary><strong><%= e.nom %></strong> <small class="muted">— exercice à partir du 1er <%= MOIS[e.debut_exercice - 1] %> · prochaine facture <%= (e.facture_prefixe || '') + e.facture_prochain %></small></summary>
  <form method="post" action="/admin/entites/<%= e.id %>" enctype="multipart/form-data" class="grid">
    <label>Début d'exercice<select name="debut_exercice"><% MOIS.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= e.debut_exercice === i + 1 ? 'selected' : '' %>>1er <%= m %></option><% }) %></select></label>
    <label>Préfixe des numéros<input name="facture_prefixe" value="<%= e.facture_prefixe || '' %>" placeholder="ex. F"></label>
    <label>Prochain numéro<input type="number" min="1" name="facture_prochain" value="<%= e.facture_prochain %>"></label>
    <label>Logo <%= e.a_logo ? '(déjà chargé)' : '' %><input type="file" name="logo" accept="image/*"></label>
    <label>N° TVA intracommunautaire<input name="facture_tva_intra" value="<%= e.facture_tva_intra || '' %>"></label>
    <label>Mention TVA<input name="facture_mention_tva" value="<%= e.facture_mention_tva || '' %>" placeholder="ex. TVA collectée sur les encaissements"></label>
    <label>Conditions de règlement par défaut<input name="facture_conditions" value="<%= e.facture_conditions || '' %>"></label>
    <label class="wide">Références bancaires (2 lignes)<textarea name="facture_banque" rows="2"><%= e.facture_banque || '' %></textarea></label>
    <label class="wide">Pénalités de retard<textarea name="facture_penalites" rows="2"><%= e.facture_penalites || '' %></textarea></label>
    <label class="wide">Pied de page (mentions légales)<textarea name="facture_pied" rows="4"><%= e.facture_pied || '' %></textarea></label>
    <div class="wide"><button>Enregistrer</button></div>
  </form>
</details>
<% }) %>

<h2 id="comptes">Comptes bancaires</h2>
<p class="muted">Société titulaire de chaque compte, reconnue automatiquement à l'import des relevés. À corriger seulement en cas d'erreur : les lignes du compte sont alors rapprochées avec les factures de la bonne société.</p>
<% if (!comptes.length) { %><p class="muted">Aucun compte (aucun relevé importé).</p><% } else { %>
<table>
  <thead><tr><th>Compte</th><th>N° (4 derniers chiffres)</th><th>Société titulaire</th></tr></thead>
  <tbody>
  <% comptes.forEach(c => { %>
    <tr><td><%= c.banque === 'AMEX' ? 'Carte AMEX' : c.nature === 'carte' ? 'Carte ' + c.banque : 'Compte ' + c.banque %></td><td>…<%= c.numero || '?' %></td>
      <td><form method="post" action="/comptes/<%= c.id %>" class="inline"><input type="hidden" name="retour" value="admin">
        <select name="entite_id" onchange="if (confirm('Changer la société titulaire de ce compte ?')) this.form.submit(); else this.form.reset();">
          <option value="">— à préciser —</option>
          <% entites.forEach(e => { %><option value="<%= e.id %>" <%= c.entite_id === e.id ? 'selected' : '' %>><%= e.nom %></option><% }) %>
        </select></form></td></tr>
  <% }) %>
  </tbody>
</table>
<% } %>

<h2>Utilisateurs</h2>
<table>
  <thead><tr><th>Nom</th><th>Email</th><th>Rôle</th><th>Nouveau mot de passe</th><th></th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
    <tr>
      <td><%= u.nom %></td>
      <td><%= u.email %></td>
      <td><%= u.is_admin ? 'Administrateur' : 'Utilisateur' %></td>
      <td>
        <form method="post" action="/admin/users/<%= u.id %>/password" class="inline">
          <input type="email" name="username" value="<%= u.email %>" autocomplete="username" hidden>
          <input type="password" name="password" autocomplete="new-password" minlength="8" placeholder="8 caractères min." required>
          <button class="secondary">Changer</button>
        </form>
      </td>
      <td>
        <% if (u.id !== user.id) { %>
        <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline" onsubmit="return confirm('Supprimer cet utilisateur ?')">
          <button class="danger">Supprimer</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>

<div class="card">
  <h3>Ajouter un utilisateur</h3>
  <form method="post" action="/admin/users" class="grid">
    <label>Nom<input name="nom" required></label>
    <label>Email<input type="email" name="email" autocomplete="username" required></label>
    <label>Mot de passe<input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
    <label class="inline"><input type="checkbox" name="is_admin" value="1"> Administrateur</label>
    <div class="wide"><button>Créer</button></div>
  </form>
</div>

<div class="cols">
  <div class="card">
    <h3>Sociétés</h3>
    <ul><% entites.forEach(e => { %><li><%= e.nom %></li><% }) %></ul>
    <form method="post" action="/admin/entites" class="inline"><input name="nom" placeholder="Nouvelle société" required> <button class="secondary">Ajouter</button></form>
  </div>
  <div class="card">
    <h3>Catégories</h3>
    <ul><% categories.forEach(c => { %><li><%= c.nom %></li><% }) %></ul>
    <form method="post" action="/admin/categories" class="inline"><input name="nom" placeholder="Nouvelle catégorie" required> <button class="secondary">Ajouter</button></form>
  </div>
</div>
<div class="card">
  <h3>Moyens de paiement par société</h3>
  <form method="post" action="/admin/moyens">
    <table>
      <thead><tr><th>Société</th><% PAIEMENTS.forEach(p => { %><th class="center"><%= p %></th><% }) %></tr></thead>
      <tbody>
      <% entites.forEach(e => { %>
        <tr><td><%= e.nom %></td>
          <% PAIEMENTS.forEach(p => { %><td class="center"><input type="checkbox" name="m" value="<%= e.id %>|<%= p %>" <%= (moyens[e.id] || []).includes(p) ? 'checked' : '' %>></td><% }) %>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <p><button>Enregistrer</button></p>
  </form>
</div>
<%- include('partials/footer') %>
