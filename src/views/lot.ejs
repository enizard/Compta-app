<%- include('partials/header') %>
<h1><%= lot.nom %></h1>
<% if (lot.statut === 'en_cours') { %>
  <div class="split">
    <div class="card apercu">
      <% if (lot.mimetype === 'application/pdf') { %><iframe src="/lot/<%= lot.id %>/fichier"></iframe>
      <% } else { %><img src="/lot/<%= lot.id %>/fichier" alt="Document déposé"><% } %>
    </div>
    <div class="card">
      <h1>Lecture en cours…</h1>
      <p class="muted"><span id="prog"><%= lot.total_pages ? `${lot.pages_traitees} / ${lot.total_pages} page(s) lue(s)` : 'Analyse du document' %></span> — les informations s'afficheront ici dès qu'elles seront prêtes.</p>
      <div class="barre"><div id="barre" style="width: <%= lot.total_pages ? Math.round(100 * lot.pages_traitees / lot.total_pages) : 5 %>%"></div></div>
      <div class="squelette"><div></div><div></div><div></div><div></div><div></div><div></div></div>
    </div>
  </div>
  <script>
    setInterval(async () => {
      const r = await fetch('/lot/<%= lot.id %>/etat.json').then((x) => x.json()).catch(() => null);
      if (!r) return;
      if (r.a_valider > 0 || r.statut !== 'en_cours') return location.replace('/lot/<%= lot.id %>');
      if (r.total) {
        document.getElementById('prog').textContent = `${r.faites} / ${r.total} page(s) lue(s)`;
        document.getElementById('barre').style.width = Math.max(5, Math.round(100 * r.faites / r.total)) + '%';
      }
    }, 1500);
  </script>
<% } else if (lot.statut === 'erreur') { %>
  <div class="flash err">Le traitement a échoué : <%= lot.erreur %></div>
<% } else if (lot.statut === 'interrompu') { %>
  <div class="flash err">Le traitement a été interrompu (redémarrage du serveur). Les tickets déjà lus sont ci-dessous ; redéposez le fichier pour le reste.</div>
<% } else if (releve) { %>
  <div class="flash">
  <% relevesLot.forEach((r, i) => { %>
    <%= i === 0 ? 'Relevé reconnu' : 'Détail de carte inclus' %> : <strong><%= r.compte.libelle %></strong><% if (r.periode_debut) { %>, du <%= r.periode_debut.toLocaleDateString('fr-FR') %> au <%= r.periode_fin ? r.periode_fin.toLocaleDateString('fr-FR') : '?' %><% } %> —
    <%= r.nb_lignes %> ligne(s) enregistrée(s)<% if (r.nb_doublons) { %>, <%= r.nb_doublons %> déjà importée(s) ignorée(s)<% } %>, <%= r.nb_rapprochees %> rapprochée(s) automatiquement.<br>
  <% }) %>
  </div>
  <% if (lot.erreur) { %><div class="flash err"><%= lot.erreur %></div><% } %>
  <% if (relevesLot.every(r => r.nb_lignes === 0) && relevesLot.some(r => r.nb_doublons > 0)) { %>
    <div class="flash err"><strong>Ce relevé était déjà mis</strong> : toutes ses lignes avaient déjà été importées. Rien n'a été ajouté.</div>
  <% } %>
  <p><a class="btn" href="/rapprochement?compte=<%= releve.compte_id %>" target="_top">Voir le rapprochement →</a>
     <a class="btn secondary" href="/operations">Fermer</a></p>
<% } else { %>
  <div class="flash"><%= depots.length %> ticket(s) trouvé(s) sur <%= lot.total_pages %> page(s). <%= aValider.length ? aValider.length + ' à valider.' : 'Tout est traité.' %></div>
  <% if (aValider.length) { %><p><a class="btn" href="/depot/<%= aValider[0].id %>">Valider les tickets un par un →</a></p><% } %>
<% } %>

<% if (depots.length) { %>
<table>
  <thead><tr><th>Page</th><th>Fournisseur</th><th>Date</th><th class="r">Montant TTC</th><th>Statut</th></tr></thead>
  <tbody>
  <% depots.forEach(d => { %>
    <tr>
      <td><%= d.page %></td>
      <td><%= d.fournisseur || (d.erreur ? 'Lecture impossible' : '—') %></td>
      <td><%= d.date ? d.date.split('-').reverse().join('/') : '' %></td>
      <td class="r"><%= d.montant_ttc ? fmt(d.montant_ttc) : '' %></td>
      <td>
        <% if (d.statut === 'a_valider') { %><a href="/depot/<%= d.id %>">À valider</a><% if (d.doublon) { %> <span class="neg">· déjà mis ?</span><% } %>
        <% } else if (d.statut === 'enregistre') { %><span class="pos">Enregistré</span>
        <% } else { %><span class="muted">Ignoré</span><% } %>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
