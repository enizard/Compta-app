<%- include('partials/header') %>
<% const depot = typeof locals.depot !== 'undefined' ? locals.depot : null; %>
<div class="<%= depot ? 'split' : '' %>">
<% if (depot) { %>
  <div class="card apercu">
    <% if (depot.mimetype === 'application/pdf') { %>
      <iframe src="/depot/<%= depot.id %>/fichier"></iframe>
    <% } else { %>
      <a href="/depot/<%= depot.id %>/fichier" target="_blank"><img src="/depot/<%= depot.id %>/fichier" alt="Document déposé"></a>
    <% } %>
  </div>
<% } %>
<div class="card">
  <% const position = typeof locals.position !== 'undefined' ? locals.position : null; %>
  <h1><%= op.id ? 'Modifier l\'opération' : (depot ? 'Vérifier et enregistrer' : 'Nouvelle opération') %></h1>
  <% if (position && position.total > 1) { %>
    <p class="muted">Ticket <%= position.rang %> sur <%= position.total %> — page <%= depot.page %> du scan — <%= position.restants %> restant(s) à valider · <a href="/lot/<%= depot.lot_id %>?liste=1">voir la liste</a></p>
  <% } %>
  <% if (depot && depot.resultat && depot.resultat.position) { %>
    <p class="muted">Sur la page : <strong><%= depot.resultat.position %></strong></p>
  <% } %>
  <% const doublons = typeof locals.doublons !== 'undefined' ? locals.doublons : []; %>
  <% if (doublons.length) { %>
    <div class="flash err"><strong>Déjà mis ?</strong> Une opération identique existe déjà :
      <% doublons.forEach(o => { %><br>· <a href="/operations/<%= o.id %>/edit" target="_blank"><%= o.date_op.toLocaleDateString('fr-FR') %> — <%= o.tiers || o.libelle %> — <%= fmt(o.montant_ttc) %> € (<%= o.entite %>)</a><% }) %>
      <br>Si c'est le même ticket, cliquez sur « Ignorer ce ticket » en bas.</div>
  <% } %>
  <% if (depot && depot.erreur) { %>
    <div class="flash err">L'analyse automatique n'a pas fonctionné (<%= depot.erreur %>). Complétez à la main.</div>
  <% } else if (depot && depot.resultat) { %>
    <div class="flash">Informations extraites automatiquement — vérifiez avant d'enregistrer<% if (depot.resultat.confiance && depot.resultat.confiance !== 'haute') { %> (confiance <%= depot.resultat.confiance %>)<% } %>.</div>
  <% } %>
  <form method="post" action="<%= op.id ? '/operations/' + op.id : '/operations' %>" enctype="multipart/form-data" class="grid">
    <% if (depot) { %><input type="hidden" name="depot_id" value="<%= depot.id %>"><% } %>
    <% const ligne = typeof locals.ligne !== 'undefined' ? locals.ligne : null; %>
    <% if (ligne) { %><input type="hidden" name="ligne_id" value="<%= ligne.id %>">
      <div class="wide flash">Écriture créée à partir de la ligne de relevé « <%= ligne.libelle %> » — elle y sera rapprochée.</div><% } %>
    <label>Société *
      <select name="entite_id" required>
        <option value="">—</option>
        <% entites.forEach(e => { %><option value="<%= e.id %>" <%= op.entite_id === e.id ? 'selected' : '' %>><%= e.nom %></option><% }) %>
        <option value="inconnue" <%= op.id && op.entite_id === null ? 'selected' : '' %>>Je ne sais plus (déterminée au rapprochement bancaire)</option>
      </select>
    </label>
    <label>Date *<input type="date" name="date_op" value="<%= op.date_op %>" required></label>
    <label>Type *
      <select name="type">
        <option value="depense" <%= op.type === 'depense' ? 'selected' : '' %>>Dépense</option>
        <option value="recette" <%= op.type === 'recette' ? 'selected' : '' %>>Recette</option>
      </select>
    </label>
    <label>Catégorie
      <select name="categorie_id">
        <option value="">—</option>
        <% categories.forEach(c => { %><option value="<%= c.id %>" <%= op.categorie_id === c.id ? 'selected' : '' %>><%= c.nom %></option><% }) %>
      </select>
    </label>
    <label class="wide">Libellé *<input name="libelle" value="<%= op.libelle || '' %>" required></label>
    <label>Tiers (client / fournisseur)<input name="tiers" value="<%= op.tiers || '' %>"></label>
    <label>Montant TTC (€) *<input name="montant_ttc" inputmode="decimal" value="<%= op.montant_ttc != null ? String(op.montant_ttc).replace('.', ',') : '' %>" required></label>
    <label>dont TVA (€)<input name="tva" inputmode="decimal" value="<%= op.tva != null && Number(op.tva) ? String(op.tva).replace('.', ',') : '' %>"></label>
    <label>Montant HT (€)<input id="ht" readonly tabindex="-1" class="readonly"></label>
    <label>Montant débité (€) <small class="muted">si différent : crédit, avoir…</small><input name="montant_debite" inputmode="decimal" value="<%= op.montant_debite != null ? String(op.montant_debite).replace('.', ',') : '' %>"></label>
    <label>Paiement
      <select name="paiement">
        <option value="">Je ne sais plus (déterminé au rapprochement bancaire)</option>
        <% PAIEMENTS.forEach(p => { %><option <%= op.paiement === p ? 'selected' : '' %>><%= p %></option><% }) %>
      </select>
    </label>
    <label>Règlement
      <select name="reglement">
        <option value="">—</option>
        <% REGLEMENTS.forEach(x => { %><option <%= op.reglement === x ? 'selected' : '' %>><%= x %></option><% }) %>
      </select>
    </label>
    <div class="wide">
      <label class="inline"><input type="checkbox" name="plusieurs_fois" value="1" id="plusieurs" <%= op.reglements && op.reglements.length ? 'checked' : '' %>> Réglé en plusieurs fois</label>
      <div id="echeancier" <%= op.reglements && op.reglements.length ? '' : 'hidden' %>>
        <table class="echeances">
          <thead><tr><th>Date</th><th>Montant (€)</th><th>Moyen de paiement</th><th></th></tr></thead>
          <tbody id="lignesReg">
            <% (op.reglements && op.reglements.length ? op.reglements : [{}]).forEach(r => { %>
            <tr>
              <td><input type="date" name="reg_date[]" value="<%= r.date_reg || '' %>"></td>
              <td><input name="reg_montant[]" inputmode="decimal" value="<%= r.montant != null ? String(r.montant).replace('.', ',') : '' %>"></td>
              <td><select name="reg_paiement[]"><option value="">—</option><% PAIEMENTS.forEach(p => { %><option <%= r.paiement === p ? 'selected' : '' %>><%= p %></option><% }) %></select></td>
              <td><button type="button" class="link" onclick="supprReg(this)">retirer</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <button type="button" class="secondary" onclick="ajoutReg()">+ Ajouter un paiement</button>
        <small class="muted" id="resteReg"></small>
        <small class="muted">— le statut de règlement est calculé à partir de ces paiements.</small>
      </div>
    </div>
    <label>Livraison
      <select name="livraison">
        <option value="">—</option>
        <% LIVRAISONS.forEach(x => { %><option <%= op.livraison === x ? 'selected' : '' %>><%= x %></option><% }) %>
      </select>
    </label>
    <label>Carte utilisée<input name="carte" value="<%= op.carte || '' %>" placeholder="ex. VISA **** 1234"></label>
    <% if (depot) { %><div><small class="muted">Justificatif : <%= depot.nom %> (joint automatiquement)</small></div><% } else { %>
    <label>Justificatif (PDF, image — 10 Mo max)
      <input type="file" name="justificatif" accept=".pdf,image/*">
      <% if (op.justif_nom) { %>
        <small>Actuel : <a href="/operations/<%= op.id %>/justificatif" target="_blank"><%= op.justif_nom %></a>
        — <label class="inline"><input type="checkbox" name="suppr_justif" value="1"> supprimer</label></small>
      <% } %>
    </label>
    <% } %>
    <label class="wide">Notes<textarea name="notes" rows="2"><%= op.notes || '' %></textarea></label>
    <div class="wide actions">
      <button>Enregistrer</button>
      <% if (!op.id && !depot) { %><button name="encore" value="1" class="secondary">Enregistrer et saisir une autre</button><% } %>
      <a href="/operations">Annuler</a>
    </div>
  </form>
  <% if (op.id) { %>
    <form method="post" action="/operations/<%= op.id %>/delete" onsubmit="return confirm('Supprimer cette opération ?')">
      <button class="danger">Supprimer l'opération</button>
    </form>
  <% } %>
  <% if (depot) { %>
    <form method="post" action="/depot/<%= depot.id %>/ignorer" class="ignorer">
      <button class="secondary">Ignorer ce ticket</button>
    </form>
  <% } %>
</div>
</div>
<script>
  (function () {
    const f = document.querySelector('form.grid');
    const num = (v) => parseFloat(String(v || '').replace(/\s/g, '').replace(',', '.')) || 0;
    function maj() {
      const ttc = num(f.montant_ttc.value), tva = num(f.tva.value);
      document.getElementById('ht').value = f.montant_ttc.value ? (ttc - tva).toFixed(2).replace('.', ',') : '';
    }
    f.montant_ttc.addEventListener('input', maj); f.tva.addEventListener('input', maj); maj();
    const ech = document.getElementById('echeancier'), corps = document.getElementById('lignesReg');
    function reste() {
      const tot = [...corps.querySelectorAll('input[name="reg_montant[]"]')].reduce((a, i) => a + num(i.value), 0);
      const r = num(f.montant_ttc.value) - tot;
      document.getElementById('resteReg').textContent = ` Total payé : ${tot.toFixed(2).replace('.', ',')} € — reste à payer : ${r.toFixed(2).replace('.', ',')} €`;
    }
    document.getElementById('plusieurs').addEventListener('change', (e) => { ech.hidden = !e.target.checked; });
    window.ajoutReg = () => { const tr = corps.rows[0].cloneNode(true); tr.querySelectorAll('input').forEach((i) => i.value = ''); tr.querySelector('select').value = ''; corps.appendChild(tr); };
    window.supprReg = (b) => { if (corps.rows.length > 1) b.closest('tr').remove(); else b.closest('tr').querySelectorAll('input').forEach((i) => i.value = ''); reste(); };
    corps.addEventListener('input', reste); f.montant_ttc.addEventListener('input', reste); reste();
  })();
</script>
<%- include('partials/footer') %>
