<%- include('partials/header') %>
<% if (!iaActive) { %>
  <div class="flash err">La lecture automatique n'est pas activée (clé API Claude à configurer) : les champs seront à remplir à la main.</div>
<% } %>
<form id="fdepot" method="post" action="/depot" enctype="multipart/form-data">
  <label class="drop compacte" id="zone">
    <strong>📄 Glissez ici un ou plusieurs fichiers — factures, tickets, scans, relevés CIC / AMEX</strong>
    <span class="muted">ou cliquez pour choisir des fichiers / prendre une photo</span>
    <input type="file" name="fichier" id="fichier" accept="application/pdf,image/*" multiple hidden>
  </label>
</form>
<div id="msgDepot"></div>
<div id="fileGroupe" class="flash" hidden></div>
<% if (enAttente.length) { %>
  <div class="attente">
    <% enAttente.forEach(l => { %>
      <span><%= l.nom %> — <%= l.restants ? l.restants + ' ticket(s) à valider' : 'lecture en cours…' %>
        <button type="button" class="link" onclick="ouvrir('/lot/<%= l.id %>')">ouvrir</button></span>
    <% }) %>
  </div>
<% } %>

<div id="modale" hidden>
  <div class="modale-fond" onclick="fermer()"></div>
  <div class="modale-boite">
    <button type="button" class="modale-x" onclick="fermer()" title="Fermer">×</button>
    <iframe id="cadre" title="Dépôt"></iframe>
  </div>
</div>

<div class="head">
  <h1>Opérations</h1>
  <div>
    <a class="btn" href="/operations/new<%= q.entite ? '?entite=' + q.entite : '' %>">+ Nouvelle opération</a>
    <a class="btn secondary" href="/export.csv?<%= qs %>">Exporter CSV</a>
  </div>
</div>

<form class="filters" method="get" action="/operations">
  <select name="entite">
    <option value="">Toutes les sociétés</option>
    <% entites.forEach(e => { %><option value="<%= e.id %>" <%= String(q.entite) === String(e.id) ? 'selected' : '' %>><%= e.nom %></option><% }) %>
    <option value="inconnue" <%= q.entite === 'inconnue' ? 'selected' : '' %>>Société à déterminer</option>
  </select>
  <select name="annee">
    <option value="">Toutes les années</option>
    <% const ans = [...new Set([new Date().getFullYear(), ...annees])].sort((a,b)=>b-a); %>
    <% ans.forEach(a => { %><option <%= String(q.annee) === String(a) ? 'selected' : '' %>><%= a %></option><% }) %>
  </select>
  <select name="mois">
    <option value="">Tous les mois</option>
    <% ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'].forEach((m,i) => { %>
      <option value="<%= i+1 %>" <%= String(q.mois) === String(i+1) ? 'selected' : '' %>><%= m %></option>
    <% }) %>
  </select>
  <select name="type">
    <option value="">Recettes et dépenses</option>
    <option value="recette" <%= q.type === 'recette' ? 'selected' : '' %>>Recettes</option>
    <option value="depense" <%= q.type === 'depense' ? 'selected' : '' %>>Dépenses</option>
  </select>
  <select name="categorie">
    <option value="">Toutes catégories</option>
    <% categories.forEach(c => { %><option value="<%= c.id %>" <%= String(q.categorie) === String(c.id) ? 'selected' : '' %>><%= c.nom %></option><% }) %>
  </select>
  <input name="q" placeholder="Rechercher…" value="<%= q.q || '' %>">
  <button>Filtrer</button>
</form>

<div class="totals">
  <div><span>Recettes</span><strong class="pos"><%= fmt(tot.recettes) %> €</strong></div>
  <div><span>Dépenses</span><strong class="neg"><%= fmt(tot.depenses) %> €</strong></div>
  <div><span>Solde</span><strong><%= fmt(tot.recettes - tot.depenses) %> €</strong></div>
  <div><span>Opérations</span><strong><%= ops.length %></strong></div>
</div>

<table>
  <thead><tr><th>Date</th><th>Société</th><th>Libellé</th><th>Tiers</th><th>Catégorie</th><th>Paiement</th><th>Règlement</th><th class="r">Montant TTC</th><th class="r">TVA</th><th>Justif.</th></tr></thead>
  <tbody>
  <% ops.forEach(o => { %>
    <tr class="cliquable" data-href="/operations/<%= o.id %>/edit">
      <td><%= o.date_op.toLocaleDateString('fr-FR') %></td>
      <td><%= o.entite || '' %><% if (!o.entite) { %><span class="neg">À déterminer</span><% } %></td>
      <td><%= o.libelle %><% if (o.livraison && o.livraison !== 'Livré en totalité') { %> <span class="badge warn"><%= o.livraison %></span><% } %></td>
      <td><%= o.tiers || '' %></td>
      <td><%= o.categorie || '' %></td>
      <% const reg = o.reglement || (o.rapprochee || o.date_paiement || o.paiement ? 'Réglé' : 'Non réglé'); %>
      <td><%= libPaiement(o.paiement, o.entite) %><% if (!o.paiement && o.type === 'depense') { %><span class="muted">À déterminer</span><% } %></td>
      <td class="<%= reg === 'Réglé' ? 'pos' : reg === 'Non réglé' ? 'neg' : 'warn' %>"><%= reg === 'Réglé' ? '✓ Réglé' : reg === 'Non réglé' ? 'Non réglé' : reg %></td>
      <td class="r <%= o.type === 'recette' ? 'pos' : 'neg' %>"><%= o.type === 'recette' ? '+' : '−' %> <%= fmt(o.montant_ttc) %></td>
      <td class="r"><%= Number(o.tva) ? fmt(o.tva) : '' %></td>
      <td><% if (o.rapprochee) { %><span title="Rapprochée avec le relevé">🏦</span><% } %><% if (o.justif_nom) { %><a href="/operations/<%= o.id %>/justificatif" target="_blank">📎</a><% } else if (!o.rapprochee) { %><span class="muted">—</span><% } %></td>
    </tr>
  <% }) %>
  <% if (!ops.length) { %><tr><td colspan="10" class="muted center">Aucune opération.</td></tr><% } %>
  </tbody>
</table>
<script>
  // Ligne cliquable : ouvre la fiche (sauf clic sur un lien ou un bouton de la ligne).
  document.querySelectorAll('tr.cliquable').forEach((tr) => tr.addEventListener('click', (e) => {
    if (e.target.closest('a, button, input, select, form')) return;
    location.href = tr.dataset.href;
  }));
  const modale = document.getElementById('modale'), cadre = document.getElementById('cadre');
  function ouvrir(url) {
    cadre.src = url; modale.hidden = false; document.body.style.overflow = 'hidden';
  }
  function fermer() { modale.hidden = true; cadre.src = 'about:blank'; location.href = '/operations'; }
  // Quand la fenêtre revient sur la liste des opérations, le travail est fini : on la ferme.
  cadre.addEventListener('load', () => {
    try { if (cadre.contentWindow.location.pathname === '/operations') fermer(); } catch (e) {}
  });

  const zone = document.getElementById('zone'), input = document.getElementById('fichier');
  // Plusieurs fichiers : envoi par paquets de 10, puis lecture en file d'attente côté serveur, sans fenêtre.
  async function envoyerGroupe(files) {
    const tous = [...files], msgs = [];
    zone.classList.add('busy');
    for (let i = 0; i < tous.length; i += 10) {
      zone.querySelector('strong').textContent = `Envoi ${Math.min(i + 10, tous.length)} / ${tous.length} fichiers…`;
      const fd = new FormData();
      fd.append('groupe', '1');
      tous.slice(i, i + 10).forEach((f) => fd.append('fichier', f));
      try {
        const r = await fetch('/depot', { method: 'POST', body: fd, headers: { Accept: 'application/json' } }).then((x) => x.json());
        if (r.message) msgs.push(r.message);
      } catch (e) { msgs.push(`Échec de l'envoi des fichiers ${i + 1} à ${Math.min(i + 10, tous.length)} : réessayez pour ceux-là.`); }
    }
    zone.classList.remove('busy');
    zone.querySelector('strong').textContent = '📄 Glissez ici un ou plusieurs fichiers — factures, tickets, scans, relevés CIC / AMEX';
    input.value = '';
    if (msgs.length) { document.getElementById('msgDepot').innerHTML = '<div class="flash err"></div>'; document.querySelector('#msgDepot .flash').textContent = msgs.join(' '); }
    suivreGroupe();
  }
  // Avancement de la file : bandeau mis à jour, liste rechargée à la fin.
  async function suivreGroupe() {
    const b = document.getElementById('fileGroupe');
    const r = await fetch('/lots/etat.json').then((x) => x.json()).catch(() => null);
    if (!r) return;
    if (r.groupe) {
      b.hidden = false;
      b.textContent = `${r.groupe} document(s) en file d'attente : lecture et enregistrement automatiques en cours… Vous pouvez continuer à travailler.`;
      setTimeout(suivreGroupe, 5000);
    } else if (!b.hidden) location.reload();
  }
  suivreGroupe();
  async function envoyer(files) {
    if (!files.length) return;
    if (files.length > 1) return envoyerGroupe(files);
    const fd = new FormData();
    for (const f of files) fd.append('fichier', f);
    zone.classList.add('busy');
    zone.querySelector('strong').textContent = `Envoi de ${files.length} fichier(s)…`;
    // La fenêtre s'ouvre tout de suite ; elle affichera les données dès qu'elles seront lues.
    ouvrir('about:blank');
    cadre.srcdoc = '<p style="font:14px sans-serif;padding:24px;color:#6b7385">Envoi du document…</p>';
    try {
      const r = await fetch('/depot', { method: 'POST', body: fd, headers: { Accept: 'application/json' } }).then((x) => x.json());
      cadre.removeAttribute('srcdoc');
      if (r.message) document.getElementById('msgDepot').innerHTML = '<div class="flash err"></div>', document.querySelector('#msgDepot .flash').textContent = r.message;
      if (r.lots && r.lots.length) cadre.src = '/lot/' + r.lots[0];
      else { modale.hidden = true; document.body.style.overflow = ''; }
    } catch (e) {
      cadre.srcdoc = '<p style="font:14px sans-serif;padding:24px;color:#b42318">Échec de l\'envoi. Réessayez.</p>';
    }
    zone.classList.remove('busy');
    zone.querySelector('strong').textContent = '📄 Glissez ici un ou plusieurs fichiers — factures, tickets, scans, relevés CIC / AMEX';
    input.value = '';
  }
  input.addEventListener('change', () => envoyer(input.files));
  ['dragenter', 'dragover'].forEach((e) => zone.addEventListener(e, (ev) => { ev.preventDefault(); zone.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((e) => zone.addEventListener(e, (ev) => { ev.preventDefault(); zone.classList.remove('over'); }));
  zone.addEventListener('drop', (ev) => envoyer(ev.dataTransfer.files));
</script>
<%- include('partials/footer') %>
