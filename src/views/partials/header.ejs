<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Compta</title>
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <link rel="stylesheet" href="/static/style.css">
  <script>if (window.top !== window) document.documentElement.classList.add('embed');</script>
</head>
<body>
<% if (user) { %>
<nav class="top">
  <a class="brand" href="/">Compta</a>
  <a href="/operations">Opérations</a>
  <a href="/factures-vente">Factures de ventes</a>
  <a href="/rapprochement">Relevés</a>
  <a href="/resultat">Compte de résultat</a>
  <span class="sep" aria-hidden="true"></span>
  <a href="/fournisseurs">Fournisseurs</a>
  <a href="/boite">Boîte factures</a>
  <a href="/session-annuelle">Session annuelle</a>
  <a href="/a-scanner">À scanner</a>
  <a href="/synthese">Synthèse</a>
  <a href="/rien-a-faire">Rien à faire</a>
  <% if (user.is_admin) { %><a href="/admin">Administration</a><% } %>
  <span class="spacer"></span>
  <a href="/compte"><%= user.nom %></a>
  <form method="post" action="/logout" class="inline"><button class="link">Déconnexion</button></form>
</nav>
<script>
  // Entrée du menu correspondant à la page affichée.
  document.querySelectorAll('nav.top a:not(.brand)').forEach((a) => {
    const p = a.getAttribute('href');
    if (location.pathname === p || location.pathname.startsWith(p + '/')) a.classList.add('actif');
  });
</script>
<% } %>
<main>
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
