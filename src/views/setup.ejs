<%- include('partials/header') %>
<div class="card narrow">
  <h1>Premier lancement</h1>
  <p>Créez le compte administrateur.</p>
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <form method="post" action="/setup">
    <label>Nom <input name="nom" required autofocus></label>
    <label>Email <input type="email" name="email" required></label>
    <label>Mot de passe (8 caractères min.) <input type="password" name="password" minlength="8" required></label>
    <button>Créer le compte</button>
  </form>
</div>
<%- include('partials/footer') %>
