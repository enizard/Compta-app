<%- include('partials/header') %>
<div class="head">
  <h1>Synthèse <%= annee %></h1>
  <form method="get" class="filters">
    <select name="annee" onchange="this.form.submit()">
      <% [...new Set([new Date().getFullYear(), annee, ...annees])].sort((a,b)=>b-a).forEach(a => { %>
        <option <%= a === annee ? 'selected' : '' %>><%= a %></option>
      <% }) %>
    </select>
  </form>
</div>
<% const M = ['Jan','Fév','Mar','Avr','Mai','Juin','Juil','Août','Sep','Oct','Nov','Déc']; %>
<% Object.entries(parEntite).forEach(([nom, d]) => { %>
  <h2><%= nom %></h2>
  <table>
    <thead><tr><th></th><% M.forEach(m => { %><th class="r"><%= m %></th><% }) %><th class="r">Total</th></tr></thead>
    <tbody>
      <tr><td>Recettes</td><% for (let i = 1; i <= 12; i++) { %><td class="r pos"><%= d.mois[i] ? fmt(d.mois[i].recettes) : '' %></td><% } %><td class="r pos"><strong><%= fmt(d.recettes) %></strong></td></tr>
      <tr><td>Dépenses</td><% for (let i = 1; i <= 12; i++) { %><td class="r neg"><%= d.mois[i] ? fmt(d.mois[i].depenses) : '' %></td><% } %><td class="r neg"><strong><%= fmt(d.depenses) %></strong></td></tr>
      <tr><td>Solde</td><% for (let i = 1; i <= 12; i++) { %><td class="r"><%= d.mois[i] ? fmt(d.mois[i].recettes - d.mois[i].depenses) : '' %></td><% } %><td class="r"><strong><%= fmt(d.recettes - d.depenses) %></strong></td></tr>
    </tbody>
  </table>
<% }) %>
<%- include('partials/footer') %>
